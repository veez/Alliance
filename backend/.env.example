# Скопируйте в .env и при необходимости поменяйте значения.
NODE_ENV=development
PORT=3000
# Адрес фронтенда (CORS, ссылки в письмах)
APP_URL=http://localhost:5173

# Локальная БД из `npm run db:start`
DATABASE_URL=postgresql://alliance:alliance@localhost:54329/alliance?schema=public
TEST_DATABASE_URL=postgresql://alliance:alliance@localhost:54329/alliance_test?schema=public

# Секреты: в проде — длинные случайные строки (openssl rand -base64 48)
JWT_ACCESS_SECRET=dev-access-secret-change-me-please-0123456789
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
# 32 байта в base64 — ключ шифрования TOTP-секретов (AES-256-GCM)
TOTP_ENC_KEY=ZGV2LXRvdHAta2V5LTMyLWJ5dGVzLWxvbmctMDEyMzQ=
COOKIE_SECURE=false

# Почта: если SMTP_HOST пуст, письма сохраняются в var/mail/*.eml и пишутся в лог
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Альянс «Ценность каждого» <noreply@mental-alliance.ru>"

# Файлы: local (каталог STORAGE_DIR) или s3
STORAGE_DRIVER=local
STORAGE_DIR=var/files

# Ограничение попыток входа
LOGIN_MAX_FAILED=5
LOGIN_LOCK_MINUTES=15
