# Переменные для docker-compose.yml. Скопируйте в .env рядом с docker-compose.yml.
# Секреты генерируйте так: openssl rand -base64 48   (TOTP_ENC_KEY: openssl rand -base64 32)
APP_URL=https://portal.mental-alliance.ru
HTTP_PORT=8080
DB_PASSWORD=
JWT_ACCESS_SECRET=
TOTP_ENC_KEY=
COOKIE_SECURE=true
# Email первого администратора: при пустой БД создаётся приглашение, ссылка — в логе контейнера api
BOOTSTRAP_ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Альянс «Ценность каждого» <noreply@mental-alliance.ru>"
